---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Bio from '../components/Bio.astro';
import PostList from '../components/PostList.astro';
import ArchiveYearPill from '../components/ArchiveYearPill.astro';
import { getCollection } from 'astro:content';
import { SITE, absoluteUrl } from '../utils/site-info';
import { getLatestPosts, getArchiveSummary } from '../utils/posts';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = getLatestPosts(posts, 5);
const archiveSummary = getArchiveSummary(posts);

const homeUrl = absoluteUrl('/', Astro.site);
const personId = `${homeUrl}#person`;
const websiteId = `${homeUrl}#website`;
const blogId = `${homeUrl}#blog`;
const homeStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: SITE.author.name,
    url: SITE.author.url,
    sameAs: [SITE.author.github, SITE.author.x],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    url: homeUrl,
    name: SITE.name,
    alternateName: SITE.alternateName,
    description: SITE.description,
    inLanguage: SITE.language,
    author: { '@id': personId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': blogId,
    url: homeUrl,
    name: SITE.name,
    description: SITE.description,
    inLanguage: SITE.language,
    author: { '@id': personId },
    blogPost: latestPosts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: absoluteUrl(`/${post.id}/`, Astro.site),
      datePublished: post.data.date.toISOString(),
      description: post.data.description || post.data.excerpt || undefined,
    })),
  },
];
---

<Layout title="rosu 的博客" description={SITE.description} structuredData={homeStructuredData}>
  <section class="home-intro" aria-labelledby="home-intro-title" data-reveal="intro">
    <Bio />
    <h1 id="home-intro-title" class="sr-only">rosu 的博客</h1>
    <blockquote class="tagline">
      积学以储宝，酌理以富才，研阅以穷照，驯致以绎辞，然后使玄解之宰，寻声律而定墨。
      <cite>——《文心雕龙·神思》</cite>
    </blockquote>
  </section>

  <section class="home-section home-section--recent" id="recent-writing" aria-labelledby="recent-writing-title">
    <div class="section-head" data-reveal="section-head">
      <h2 id="recent-writing-title">最近写作</h2>
    </div>

    <PostList posts={latestPosts} variant="featured" />
  </section>

  <section class="home-section home-section--archive" aria-labelledby="archive-title">
    <div class="section-head" data-reveal="section-head">
      <h2 id="archive-title">归档</h2>
    </div>

    <a href="/archive/" class="archive-entry">
      <span class="archive-entry__copy">
        <span class="archive-entry__title">查看全部归档</span>
        <span class="archive-entry__meta">
          {archiveSummary.totalPosts} 篇文章，跨 {archiveSummary.totalYears} 年
        </span>
      </span>
      <span class="archive-entry__years" aria-label={`最近年份：${archiveSummary.recentYears.join('、')}`}>
        {archiveSummary.recentYears.map((year) => <ArchiveYearPill year={year} />)}
      </span>
    </a>
  </section>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home-intro {
    position: relative;
    max-width: 43rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.35rem;
    animation: home-settle 420ms var(--ease-quiet) both;
  }

  .home-intro::after {
    content: '';
    position: absolute;
    left: 0.1rem;
    bottom: 0;
    width: min(9rem, 42vw);
    height: 6px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--avatar-blue) 82%, transparent),
      color-mix(in oklab, var(--avatar-blue-bright) 54%, transparent),
      transparent
    );
    opacity: 0.82;
    transform: rotate(-1.1deg) skewX(-3deg);
    clip-path: inset(0 100% 0 0);
    animation: ink-line-reveal 560ms 120ms var(--ease-quiet) both;
    -webkit-mask-image: var(--scribble-underline-mask);
    mask-image: var(--scribble-underline-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    pointer-events: none;
  }

  .tagline {
    position: relative;
    margin: 0;
    max-width: 38rem;
    padding: 0.35rem 0 0.35rem 1.05rem;
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.85;
    text-wrap: pretty;
    letter-spacing: 0.02em;
  }

  .tagline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.18rem;
    bottom: 0.18rem;
    width: 5px;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--avatar-blue) 58%, transparent),
      color-mix(in oklab, var(--avatar-blue-bright) 36%, transparent)
    );
    opacity: 0.82;
    transform: rotate(-1deg);
    clip-path: inset(0 0 100% 0);
    animation: quote-stroke-reveal 480ms 80ms var(--ease-quiet) both;
    -webkit-mask-image: var(--scribble-quote-mask);
    mask-image: var(--scribble-quote-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .tagline cite {
    display: block;
    margin-top: 0.375rem;
    color: var(--fg-subtle);
    font-family: var(--font-serif);
    font-size: var(--text-xs);
    font-style: normal;
  }

  .home-section + .home-section {
    margin-top: 2.75rem;
  }

  .home-section--recent {
    position: relative;
    padding: 1.05rem 0 1.1rem;
  }

  .home-section--recent::before {
    content: '';
    position: absolute;
    inset: 0 -1rem;
    z-index: -1;
    border-top: 1px solid color-mix(in oklab, var(--support-border) 26%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--support-border) 22%, transparent);
    background: linear-gradient(
      100deg,
      color-mix(in oklab, var(--support-soft) 36%, transparent),
      color-mix(in oklab, var(--accent-soft) 18%, transparent) 52%,
      transparent
    );
  }

  .home-section--recent .section-head h2 {
    color: var(--accent);
  }

  .home-section--archive .section-head h2 {
    color: var(--support);
  }

  .section-head {
    display: grid;
    gap: 0;
    margin-bottom: 0.9rem;
  }

  .section-head h2 {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .archive-entry {
    min-height: 4.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 0;
    border-top: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    color: inherit;
    text-decoration: none;
    position: relative;
  }

  .archive-entry::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.42rem;
    width: min(11rem, 52%);
    height: 6px;
    background: color-mix(in oklab, var(--avatar-blue) 58%, transparent);
    opacity: 0.68;
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--duration-medium) var(--ease-quiet);
    -webkit-mask-image: var(--scribble-underline-mask);
    mask-image: var(--scribble-underline-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .archive-entry:hover::after,
  .archive-entry:focus-visible::after {
    clip-path: inset(0 0 0 0);
  }

  .archive-entry__copy {
    display: grid;
    gap: 0.18rem;
  }

  .archive-entry__title {
    color: var(--fg);
    font-weight: 560;
    line-height: 1.4;
  }

  .archive-entry__meta {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .archive-entry__years {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  @keyframes home-settle {
    from {
      opacity: 0;
      transform: translateY(7px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ink-line-reveal {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes quote-stroke-reveal {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 640px) {
    .home-intro {
      max-width: none;
      margin-bottom: 1.25rem;
    }

    .home-section--recent::before {
      inset-inline: -0.5rem;
    }

    .tagline {
      max-width: none;
      font-size: var(--text-xs);
      line-height: 1.9;
    }

    .archive-entry {
      align-items: flex-start;
      flex-direction: column;
    }

    .archive-entry__years {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-intro {
      animation: none;
      opacity: 1;
    }

    .tagline::before,
    .home-intro::after {
      animation: none;
      clip-path: inset(0 0 0 0);
    }

    .archive-entry::after,
    .home-intro::after {
      transition: none;
    }
  }
</style>
