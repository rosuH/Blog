---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Bio from '../components/Bio.astro';
import PostList from '../components/PostList.astro';
import ArchiveYearPill from '../components/ArchiveYearPill.astro';
import { getCollection } from 'astro:content';
import { SITE, absoluteUrl } from '../utils/site-info';
import { getLatestPosts, getArchiveSummary } from '../utils/posts';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = getLatestPosts(posts, 5);
const archiveSummary = getArchiveSummary(posts);

const homeUrl = absoluteUrl('/', Astro.site);
const personId = `${homeUrl}#person`;
const websiteId = `${homeUrl}#website`;
const blogId = `${homeUrl}#blog`;
const homeStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: SITE.author.name,
    url: SITE.author.url,
    sameAs: [SITE.author.github, SITE.author.x],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    url: homeUrl,
    name: SITE.name,
    alternateName: SITE.alternateName,
    description: SITE.description,
    inLanguage: SITE.language,
    author: { '@id': personId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': blogId,
    url: homeUrl,
    name: SITE.name,
    description: SITE.description,
    inLanguage: SITE.language,
    author: { '@id': personId },
    blogPost: latestPosts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: absoluteUrl(`/${post.id}/`, Astro.site),
      datePublished: post.data.date.toISOString(),
      description: post.data.description || post.data.excerpt || undefined,
    })),
  },
];
---

<Layout title="rosu 的博客" description={SITE.description} structuredData={homeStructuredData}>
  <section class="home-intro" aria-labelledby="home-intro-title" data-reveal="intro">
    <Bio />
    <h1 id="home-intro-title" class="sr-only">rosu 的博客</h1>
    <blockquote class="tagline">
      积学以储宝，酌理以富才，研阅以穷照，驯致以绎辞，然后使玄解之宰，寻声律而定墨。
      <cite>——《文心雕龙·神思》</cite>
    </blockquote>
  </section>

  <section class="home-section home-section--recent" id="recent-writing" aria-labelledby="recent-writing-title">
    <div class="section-head" data-reveal="section-head">
      <h2 id="recent-writing-title">最近写作</h2>
    </div>

    <PostList posts={latestPosts} variant="featured" />
  </section>

  <section class="home-section home-section--archive" aria-labelledby="archive-title">
    <div class="section-head" data-reveal="section-head">
      <h2 id="archive-title">归档</h2>
    </div>

    <a href="/archive/" class="archive-entry">
      <span class="archive-entry__copy">
        <span class="archive-entry__title">查看全部归档</span>
        <span class="archive-entry__meta">
          {archiveSummary.totalPosts} 篇文章，跨 {archiveSummary.totalYears} 年
        </span>
      </span>
      <span class="archive-entry__years" aria-label={`最近年份：${archiveSummary.recentYears.join('、')}`}>
        {archiveSummary.recentYears.map((year) => <ArchiveYearPill year={year} />)}
      </span>
    </a>
  </section>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home-intro {
    max-width: 43rem;
    margin-bottom: 1.5rem;
    animation: home-settle 420ms var(--ease-quiet) both;
  }

  /* 题句：白墙上的一行小字，只有缩进与淡墨，没有任何描画 */
  .tagline {
    margin: 0;
    max-width: 38rem;
    padding-left: 1.05rem;
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.85;
    text-wrap: pretty;
    letter-spacing: 0.02em;
  }

  .tagline cite {
    display: block;
    margin-top: 0.375rem;
    color: var(--fg-subtle);
    font-family: var(--font-serif);
    font-size: var(--text-xs);
    font-style: normal;
  }

  .home-section + .home-section {
    margin-top: 2.75rem;
  }

  .section-head {
    display: grid;
    gap: 0;
    margin-bottom: 1.15rem;
  }

  /* section 标题：mono 小字标签，像墙上的铅笔标注 */
  .section-head h2 {
    margin: 0;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .archive-entry {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    color: inherit;
    text-decoration: none;
  }

  .archive-entry__copy {
    display: grid;
    gap: 0.18rem;
  }

  .archive-entry__title {
    color: var(--fg);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.4;
    transition:
      transform var(--duration-fast) var(--ease-quiet),
      text-shadow var(--duration-fast) ease;
  }

  .archive-entry:hover .archive-entry__title,
  .archive-entry:focus-visible .archive-entry__title {
    transform: translateY(-2px);
    text-shadow: var(--lift-shadow-text);
  }

  .archive-entry:active .archive-entry__title {
    transform: translateY(0);
    text-shadow: none;
  }

  .archive-entry__meta {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .archive-entry__years {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.75rem;
  }

  /* 首页归档入口里的年份：小号衬线数字 */
  .archive-entry .archive-year {
    font-size: var(--text-base);
    font-weight: 550;
  }

  @keyframes home-settle {
    from {
      opacity: 0;
      transform: translateY(7px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .home-intro {
      max-width: none;
      margin-bottom: 1.25rem;
    }

    .tagline {
      max-width: none;
      font-size: var(--text-xs);
      line-height: 1.9;
    }

    .archive-entry {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .archive-entry__years {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-intro {
      animation: none;
      opacity: 1;
    }

    .archive-entry__title {
      transition: none;
    }

    .archive-entry:hover .archive-entry__title,
    .archive-entry:focus-visible .archive-entry__title {
      transform: none;
      text-shadow: none;
    }
  }
</style>
