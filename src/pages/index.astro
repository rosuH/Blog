---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Bio from '../components/Bio.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="rosu's Blog">
  <Bio />

  <blockquote class="tagline">
    积学以储宝，酌理以富才，研阅以穷照，驯致以绎辞，然后使玄解之宰，寻声律而定墨。
    <cite>——《文心雕龙·神思》</cite>
  </blockquote>

  <ul class="post-list" role="list">
    {sortedPosts.map((post, index) => (
      <li class="post-row" style={`--index: ${index}`}>
        <a href={`/${post.id}/`} class="post-title">
          {post.data.title}
        </a>
        <time
          class="post-date"
          datetime={post.data.date.toISOString()}
        >
          {post.data.date.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
          })}
        </time>
      </li>
    ))}
  </ul>
</Layout>

<style>
  /* Tagline — subtle left border for asymmetric editorial tension */
  .tagline {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    font-style: italic;
    margin: 0 0 2.5rem;
    padding: 0 0 0 0.875rem;
    border: none;
    border-left: 1.5px solid color-mix(in srgb, var(--fg-subtle) 35%, transparent);
  }

  .tagline cite {
    display: block;
    margin-top: 0.375rem;
    font-style: normal;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* ── Post row ─────────────────────────────────────────────── */
  .post-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    cursor: pointer;

    /* Staggered entrance */
    animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--index) * 55ms);

    /* Tactile feedback transition */
    transition: transform 0.08s ease;
  }

  .post-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .post-row:active {
    transform: scale(0.99) translateX(1px);
  }

  /* Directional fill — enters from the side the mouse came from */
  .post-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    transform: translateX(calc(var(--fill-dir, -1) * 100%));
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
    pointer-events: none;
  }

  .post-row.is-hovered::before {
    transform: translateX(0);
  }

  /* Spotlight glow on the top divider line, tracks cursor X */
  .post-row::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: radial-gradient(
      ellipse 40% 100% at var(--cursor-x, 50%) 50%,
      color-mix(in srgb, var(--accent) 55%, transparent),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 2;
    pointer-events: none;
  }

  .post-row.is-hovered::after {
    opacity: 1;
  }

  /* Float children above the fill layer */
  .post-title,
  .post-date {
    position: relative;
    z-index: 1;
  }

  .post-title {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.15s;
    min-width: 0;
  }

  .post-title:hover {
    color: var(--accent);
  }

  .post-date {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Touch devices: disable fill and spotlight effects */
  @media (hover: none) {
    .post-row::before,
    .post-row::after { display: none; }
  }

  /* Respect user's motion preference */
  @media (prefers-reduced-motion: reduce) {
    .post-row {
      animation: none;
      opacity: 1;
    }
    .post-row::before {
      transition: none;
    }
  }

  @media (max-width: 480px) {
    .post-row {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLLIElement>('.post-row').forEach(row => {
    const link = row.querySelector<HTMLAnchorElement>('a.post-title');

    // Make the entire row navigable (date area was previously dead zone)
    row.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('a') && link) {
        window.location.href = link.href;
      }
    });

    // Directional hover: detect which side the mouse enters from
    row.addEventListener('mouseenter', (e) => {
      const { left, width } = row.getBoundingClientRect();
      row.style.setProperty('--fill-dir', e.clientX < left + width / 2 ? '-1' : '1');
      row.classList.add('is-hovered');
    });

    // Spotlight: update --cursor-x as mouse moves across the row
    row.addEventListener('mousemove', (e) => {
      const { left, width } = row.getBoundingClientRect();
      row.style.setProperty('--cursor-x', `${((e.clientX - left) / width) * 100}%`);
    });

    row.addEventListener('mouseleave', () => {
      row.classList.remove('is-hovered');
    });
  });
</script>
