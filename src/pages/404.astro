---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = posts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout
  title="404 - 页面未找到"
  description="你访问的页面不存在，看看最近写作。"
  robots="noindex,follow"
>
  <section class="not-found">
    <p class="not-found-kicker">页面未找到</p>
    <h1>404</h1>
    <p class="not-found-copy">这篇文章可能已经迁移，或者这个链接已经失效。</p>

    <div class="not-found-actions">
      <a href="/#recent-writing" class="not-found-primary">查看最新文章</a>
      <a href="/" class="not-found-secondary">返回首页</a>
    </div>
  </section>

  <section class="recovery-list" aria-labelledby="recovery-list-title">
    <div class="recovery-head">
      <h2 id="recovery-list-title">最近文章</h2>
      <p>从这里重新进入内容区。</p>
    </div>

    <ol class="recovery-posts" role="list">
      {recentPosts.map((post, index) => (
        <li class="recovery-post" style={`--recovery-index: ${index}`}>
          <a href={`/${post.id}/`} class="recovery-link">
            <span class="recovery-title">{post.data.title}</span>
            <time datetime={post.data.date.toISOString()} class="recovery-date">
              {post.data.date.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
              })}
            </time>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Layout>

<style>
  .not-found {
    padding: 3.5rem 0 2rem;
    animation: not-found-settle-in 520ms var(--ease-out-expo) both;
  }

  .not-found-kicker {
    margin: 0 0 0.5rem;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
  }

  .not-found h1 {
    margin: 0;
    font-size: 8rem;
    line-height: 0.95;
    letter-spacing: 0;
    color: color-mix(in oklab, var(--sun) 58%, var(--fg));
  }

  .not-found-copy {
    max-width: 30rem;
    margin: 0.9rem 0 0;
    color: var(--fg-muted);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .not-found-primary,
  .not-found-secondary {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    border: none;
    border-radius: 999px;
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      text-shadow var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-quiet);
  }

  .not-found-primary {
    background: var(--sun);
    color: var(--bg);
    box-shadow: var(--lift-shadow);
  }

  .not-found-primary:hover,
  .not-found-primary:focus-visible {
    transform: translateY(-2px);
  }

  .not-found-secondary {
    background: transparent;
    color: var(--sun);
  }

  .not-found-secondary:hover {
    transform: translateY(-2px);
    text-shadow: var(--lift-shadow-text);
  }

  .recovery-list {
    padding-top: 0.5rem;
  }

  .recovery-head {
    display: grid;
    gap: 0.2rem;
    margin-bottom: 0.75rem;
  }

  .recovery-head h2 {
    margin: 0;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .recovery-head p {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .recovery-posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recovery-post {
    opacity: 0;
    animation: not-found-settle-in 460ms var(--ease-out-expo) both;
    animation-delay: calc(120ms + (var(--recovery-index, 0) * 60ms));
  }

  .recovery-post + .recovery-post {
    margin-top: 1.1rem;
  }

  .recovery-link {
    min-height: 2.75rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
  }

  .recovery-title {
    color: var(--fg);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.5;
    transition:
      transform var(--duration-fast) var(--ease-quiet),
      text-shadow var(--duration-fast) ease;
  }

  .recovery-date {
    color: var(--fg-muted);
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .recovery-link:hover .recovery-title,
  .recovery-link:focus-visible .recovery-title {
    transform: translateY(-2px);
    text-shadow: var(--lift-shadow-text);
  }

  @keyframes not-found-settle-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .not-found {
      padding: 2.5rem 0 1.5rem;
    }

    .not-found h1 {
      font-size: 4.5rem;
    }

    .recovery-link {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found,
    .recovery-post {
      animation: none;
      opacity: 1;
    }

    .not-found-primary,
    .not-found-secondary {
      transition: none;
    }
  }
</style>
