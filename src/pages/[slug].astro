---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import Bio from '../components/Bio.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sorted[index + 1] ?? null, // older post
      nextPost: sorted[index - 1] ?? null, // newer post
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description || post.data.excerpt}
  image={post.data.hero}
  article={true}
>
  <article itemscope itemtype="http://schema.org/BlogPosting">
    <header class="article-header">
      <h1 itemprop="headline">{post.data.title}</h1>
      <div class="article-meta">
        <time
          datetime={post.data.date.toISOString()}
          itemprop="datePublished"
        >
          {post.data.date.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {(post.data.tags ?? []).length > 0 && (
          <>
            <span class="meta-sep">·</span>
            <div class="article-tags" role="list">
              {post.data.tags.map((tag) => (
                <span class="article-tag" role="listitem">{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    <section class="prose" itemprop="articleBody">
      <Content />
    </section>

    <footer class="article-footer">
      <Bio compact={true} />
    </footer>
  </article>

  {(prevPost || nextPost) && (
    <nav class="post-nav" aria-label="Article navigation">
      <div>
        {prevPost && (
          <a href={`/${prevPost.id}/`} rel="prev" class="nav-prev">
            <span class="nav-label">Earlier</span>
            <span class="nav-title">{prevPost.data.title}</span>
          </a>
        )}
      </div>
      <div>
        {nextPost && (
          <a href={`/${nextPost.id}/`} rel="next" class="nav-next">
            <span class="nav-label">Later</span>
            <span class="nav-title">{nextPost.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  )}
</Layout>

<style>
  .article-header {
    margin-bottom: 3rem;
  }

  .article-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .meta-sep {
    color: var(--fg-subtle);
  }

  .article-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .article-tag {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    border: 1px solid var(--border);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .post-nav > div {
    flex: 1;
  }

  .nav-prev,
  .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-next {
    text-align: right;
  }

  .nav-label {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-title {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    font-weight: 500;
    transition: color 0.15s;
  }

  .nav-prev:hover .nav-title,
  .nav-next:hover .nav-title {
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .article-header h1 {
      font-size: var(--text-2xl);
    }

    .post-nav {
      flex-direction: column;
    }

    .nav-next {
      text-align: left;
    }
  }
</style>
