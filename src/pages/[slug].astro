---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import Bio from '../components/Bio.astro';
import { getCollection, render } from 'astro:content';
import { SITE, absoluteUrl } from '../utils/site-info';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sorted[index + 1] ?? null,
      nextPost: sorted[index - 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const needsMath = /\$\$|\\\(|\\\[/.test(post.body ?? '');
const postUrl = absoluteUrl(`/${post.id}/`, Astro.site);
const postDescription = post.data.description || post.data.excerpt || SITE.description;
const personId = `${absoluteUrl('/', Astro.site)}#person`;
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  headline: post.data.title,
  description: postDescription,
  url: postUrl,
  mainEntityOfPage: postUrl,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  inLanguage: SITE.language,
  author: {
    '@type': 'Person',
    '@id': personId,
    name: SITE.author.name,
    url: SITE.author.url,
    sameAs: [SITE.author.github, SITE.author.x],
  },
  publisher: {
    '@type': 'Person',
    '@id': personId,
    name: SITE.author.name,
    url: SITE.author.url,
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': `${absoluteUrl('/', Astro.site)}#blog`,
    name: SITE.name,
    url: absoluteUrl('/', Astro.site),
  },
  keywords: [...(post.data.tags ?? []), ...(post.data.categories ?? [])].filter(Boolean),
};
---

<Layout
  title={post.data.title}
  description={postDescription}
  image={post.data.hero}
  article={true}
  math={needsMath}
  structuredData={articleStructuredData}
>
  <div id="reading-progress" aria-hidden="true"></div>

  <article class="article-shell" itemscope itemtype="http://schema.org/BlogPosting">
    <header class="article-header" data-reveal="article-header">
      <p class="article-kicker">文章</p>
      <h1 class="article-title" itemprop="headline">{post.data.title}</h1>
      <div class="article-meta">
        <time
          class="article-date"
          datetime={post.data.date.toISOString()}
          itemprop="datePublished"
        >
          {post.data.date.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {(post.data.tags ?? []).length > 0 && (
          <div class="article-tags" role="list" aria-label="文章标签">
            {post.data.tags.map((tag) => (
              <span class="article-tag" role="listitem">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <section class="prose" itemprop="articleBody">
      <Content />
    </section>

    <footer class="article-footer">
      <Bio compact={true} />
    </footer>
  </article>

  {(prevPost || nextPost) && (
    <nav class="post-nav" aria-label="文章导航">
      <div>
        {prevPost && (
          <a href={`/${prevPost.id}/`} rel="prev" class="nav-prev">
            <span class="nav-label">上一篇</span>
            <span class="nav-title">{prevPost.data.title}</span>
          </a>
        )}
      </div>
      <div>
        {nextPost && (
          <a href={`/${nextPost.id}/`} rel="next" class="nav-next">
            <span class="nav-label">下一篇</span>
            <span class="nav-title">{nextPost.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  )}

  <div id="img-lightbox" class="img-lightbox" role="dialog" aria-modal="true" aria-label="图片预览" tabindex="-1">
    <div class="img-lightbox__backdrop" data-lightbox-close role="button" tabindex="0" aria-label="关闭图片预览"></div>
    <img class="img-lightbox__img" src="" alt="" tabindex="0" />
  </div>
</Layout>

<script>
  (function () {
    const bar = document.getElementById('reading-progress') as HTMLElement | null;
    const article = document.querySelector('article') as HTMLElement | null;
    if (!bar || !article) return;

    let ticking = false;

    function update() {
      const { top, height } = article.getBoundingClientRect();
      const scrollable = height - window.innerHeight;
      const progress = scrollable > 0 ? Math.max(0, Math.min(1, -top / scrollable)) : 0;
      bar.style.transform = `scaleX(${progress})`;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });

    update();
  })();

  (function () {
    const lightbox = document.getElementById('img-lightbox') as HTMLElement | null;
    if (!lightbox) return;

    const lbImg = lightbox.querySelector('.img-lightbox__img') as HTMLImageElement;
    const closeTriggers = lightbox.querySelectorAll('[data-lightbox-close]');
    let lastFocused: HTMLElement | null = null;
    let isOpen = false;
    let activeSource: HTMLElement | null = null;

    function open(src: string, alt: string, sourceEl: HTMLElement) {
      if (isOpen) return;
      activeSource = sourceEl;
      lastFocused = document.activeElement as HTMLElement;
      lbImg.src = src;
      lbImg.alt = alt;

      const firstRect = sourceEl.getBoundingClientRect();

      function beginAnimation() {
        lightbox.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        isOpen = true;
        lbImg.focus();

        const lastRect = lbImg.getBoundingClientRect();
        const scale = firstRect.width / lastRect.width;
        const translateX = firstRect.left - lastRect.left + (firstRect.width - lastRect.width) / 2;
        const translateY = firstRect.top - lastRect.top + (firstRect.height - lastRect.height) / 2;

        lbImg.style.transition = 'none';
        lbImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
        lbImg.style.opacity = '1';

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            lbImg.style.transition = 'transform 0.4s var(--ease-out-expo), opacity 0.2s ease';
            lbImg.style.transform = '';
          });
        });
      }

      if (lbImg.complete && lbImg.naturalWidth > 0) {
        beginAnimation();
      } else {
        const onLoad = () => {
          lbImg.removeEventListener('load', onLoad);
          lbImg.removeEventListener('error', onLoad);
          beginAnimation();
        };
        lbImg.addEventListener('load', onLoad);
        lbImg.addEventListener('error', onLoad);
      }
    }

    function close() {
      if (!isOpen) return;

      let firstRect: DOMRect | null = null;
      if (activeSource && activeSource.isConnected) {
        const r = activeSource.getBoundingClientRect();
        if (r.top < window.innerHeight && r.bottom > 0) {
          firstRect = r;
        }
      }

      if (firstRect) {
        const lastRect = lbImg.getBoundingClientRect();
        const scale = firstRect.width / lastRect.width;
        const translateX = firstRect.left - lastRect.left + (firstRect.width - lastRect.width) / 2;
        const translateY = firstRect.top - lastRect.top + (firstRect.height - lastRect.height) / 2;

        lbImg.style.transition = 'none';
        lbImg.style.transform = '';

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            lbImg.style.transition = 'transform 0.35s var(--ease-out-expo), opacity 0.25s ease';
            lbImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
            lbImg.style.opacity = '0';
            lightbox.classList.remove('is-open');
            setTimeout(cleanup, 350);
          });
        });
      } else {
        lightbox.classList.remove('is-open');
        lbImg.style.transition = 'transform 0.3s ease, opacity 0.25s ease';
        lbImg.style.transform = 'scale(0.92)';
        lbImg.style.opacity = '0';
        setTimeout(cleanup, 300);
      }
    }

    function cleanup() {
      document.body.style.overflow = '';
      isOpen = false;
      lastFocused?.focus();
      lastFocused = null;
      activeSource = null;
      lbImg.src = '';
      lbImg.alt = '';
      lbImg.style.transition = '';
      lbImg.style.transform = '';
      lbImg.style.opacity = '';
    }

    lbImg.style.cursor = 'zoom-out';
    lbImg.addEventListener('click', close);

    document.querySelectorAll<HTMLElement>('.media-figure:not(.livephoto) img').forEach((el) => {
      el.style.cursor = 'zoom-in';
      el.addEventListener('click', () => {
        const target = el as HTMLImageElement;
        open(target.currentSrc || target.src, target.alt, el);
      });
    });

    closeTriggers.forEach((t) => {
      t.addEventListener('click', close);
      t.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === ' ' || ke.key === 'Enter') {
          ke.preventDefault();
          close();
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === 'Tab') {
        const focusables: HTMLElement[] = [lbImg];
        closeTriggers.forEach((t) => focusables.push(t as HTMLElement));
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (e.shiftKey) {
          if (active === first || !lightbox.contains(active)) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (active === last || !lightbox.contains(active)) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });
  })();

  (function () {
    if (!navigator.clipboard) return;

    const copyIcon = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    const checkIcon = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 12 4 9"/></svg>`;
    const copiedLabel = '已复制';

    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const button = document.createElement('button');
      button.className = 'copy-btn';
      button.setAttribute('aria-label', '复制代码');
      button.setAttribute('data-copied-label', copiedLabel);
      button.innerHTML = copyIcon;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        try {
          await navigator.clipboard.writeText(code?.innerText ?? '');
          button.innerHTML = checkIcon;
          button.classList.add('copied');
          setTimeout(() => {
            button.innerHTML = copyIcon;
            button.classList.remove('copied');
          }, 1500);
        } catch {
          // Clipboard API unavailable or denied — fail silently
        }
      });

      wrapper.appendChild(button);
    });
  })();

  (function () {
    const prose = document.querySelector('.prose');
    if (!prose) return;

    const headings = Array.from(prose.querySelectorAll('h2, h3'));
    if (headings.length < 3) return;

    headings.forEach((el, i) => {
      if (!el.id) el.id = `heading-${i}`;
    });

    // 构建共享的 TOC 列表 DOM
    const tocList = document.createElement('ul');
    tocList.className = 'toc-list';
    headings.forEach((el) => {
      const li = document.createElement('li');
      li.className = el.tagName === 'H2' ? 'toc-item toc-item--h2' : 'toc-item toc-item--h3';
      const a = document.createElement('a');
      a.href = `#${el.id}`;
      a.textContent = el.textContent ?? '';
      a.className = 'toc-link';
      a.dataset.headingId = el.id;
      li.appendChild(a);
      tocList.appendChild(li);
    });

    // 桌面端 TOC
    const tocAside = document.createElement('nav');
    tocAside.className = 'toc-aside';
    tocAside.setAttribute('aria-label', '目录');
    const tocTitle = document.createElement('div');
    tocTitle.className = 'toc-title';
    tocTitle.textContent = '目录';
    tocAside.appendChild(tocTitle);
    tocAside.appendChild(tocList.cloneNode(true));
    const article = document.querySelector('.article-shell');
    article?.appendChild(tocAside);

    // 移动端 TOC 面板
    const tocMobile = document.createElement('div');
    tocMobile.className = 'toc-mobile';
    tocMobile.setAttribute('aria-hidden', 'true');

    const mobileBackdrop = document.createElement('div');
    mobileBackdrop.className = 'toc-mobile__backdrop';
    mobileBackdrop.addEventListener('click', closeMobileToc);

    const mobilePanel = document.createElement('div');
    mobilePanel.className = 'toc-mobile__panel';

    const mobileClose = document.createElement('button');
    mobileClose.type = 'button';
    mobileClose.className = 'toc-mobile__close';
    mobileClose.setAttribute('aria-label', '关闭目录');
    mobileClose.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
    mobileClose.addEventListener('click', closeMobileToc);

    const mobileTitle = document.createElement('div');
    mobileTitle.className = 'toc-title';
    mobileTitle.textContent = '目录';

    mobilePanel.appendChild(mobileClose);
    mobilePanel.appendChild(mobileTitle);
    mobilePanel.appendChild(tocList.cloneNode(true));
    tocMobile.appendChild(mobileBackdrop);
    tocMobile.appendChild(mobilePanel);
    document.body.appendChild(tocMobile);

    // 移动端触发按钮
    const tocTrigger = document.createElement('button');
    tocTrigger.type = 'button';
    tocTrigger.className = 'toc-trigger';
    tocTrigger.setAttribute('aria-label', '打开目录');
    tocTrigger.setAttribute('aria-expanded', 'false');
    tocTrigger.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg><span>文章目录</span>';

    let tocLastFocused: HTMLElement | null = null;

    tocTrigger.addEventListener('click', () => {
      tocLastFocused = document.activeElement as HTMLElement;
      tocMobile.classList.add('is-open');
      tocMobile.setAttribute('aria-hidden', 'false');
      tocTrigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      mobileClose.focus();
    });
    document.body.appendChild(tocTrigger);

    function closeMobileToc() {
      tocMobile.classList.remove('is-open');
      tocMobile.setAttribute('aria-hidden', 'true');
      tocTrigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      const toFocus = tocLastFocused ?? tocTrigger;
      toFocus.focus();
      tocLastFocused = null;
    }

    document.addEventListener('keydown', (e) => {
      if (!tocMobile.classList.contains('is-open')) return;
      if (e.key === 'Escape') {
        closeMobileToc();
        return;
      }
      if (e.key === 'Tab') {
        const focusables = Array.from(
          mobilePanel.querySelectorAll<HTMLElement>('button, a[href]')
        ).filter((el) => !el.hasAttribute('disabled'));
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (e.shiftKey) {
          if (active === first || !mobilePanel.contains(active)) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (active === last || !mobilePanel.contains(active)) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });

    // 所有 TOC 链接的点击处理（事件委托 + 直接绑定）
    function onTocClick(e) {
      if (!(e.target instanceof Element)) return;
      const link = e.target.closest('.toc-link');
      if (!link) return;
      e.preventDefault();
      const id = link.dataset.headingId;
      const heading = document.getElementById(id);
      if (!heading) return;

      // 同步高亮所有 TOC 中的对应链接
      document.querySelectorAll('.toc-link').forEach((l) => l.classList.remove('is-active'));
      document.querySelectorAll(`.toc-link[data-heading-id="${id}"]`).forEach((l) => l.classList.add('is-active'));

      // 关闭移动端面板
      closeMobileToc();

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        window.scrollTo(0, heading.offsetTop - 12);
        return;
      }

      // 滚动前先渐隐内容
      prose.style.transition = 'opacity 0.2s ease';
      prose.style.opacity = '0.25';

      const rect = heading.getBoundingClientRect();
      const targetY = window.scrollY + rect.top - 12;
      const startY = window.scrollY;
      const distance = targetY - startY;
      const duration = 450;
      const startTime = performance.now();

      function step(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        window.scrollTo(0, startY + distance * eased);
        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          prose.style.opacity = '1';
          setTimeout(() => { prose.style.transition = ''; }, 200);
        }
      }
      requestAnimationFrame(step);

      setTimeout(() => {
        const r = heading.getBoundingClientRect();
        if (Math.abs(r.top - 12) > 8) {
          window.scrollTo(0, window.scrollY + r.top - 12);
        }
      }, 520);
    }
    document.querySelectorAll('.toc-aside, .toc-mobile__panel').forEach((container) => {
      container.addEventListener('click', onTocClick);
    });

    // 滚动时高亮最靠近视口上方 30% 处的 heading
    let ticking = false;
    function updateActive() {
      const mark = window.innerHeight * 0.3;
      let best = null;
      let bestTop = -Infinity;
      headings.forEach((h) => {
        const top = h.getBoundingClientRect().top;
        if (top <= mark && top > bestTop) {
          bestTop = top;
          best = h;
        }
      });
      if (best) {
        const id = best.id;
        document.querySelectorAll('.toc-link').forEach((link) => {
          link.classList.toggle('is-active', link.dataset.headingId === id);
        });
      }
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateActive);
        ticking = true;
      }
    }, { passive: true });
    updateActive();
  })();

  (function () {
    const backToTop = document.createElement('button');
    backToTop.type = 'button';
    backToTop.className = 'back-to-top';
    backToTop.setAttribute('aria-label', '返回顶部');
    backToTop.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>';

    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    document.body.appendChild(backToTop);

    let ticking = false;
    function toggleVisibility() {
      if (window.scrollY > 600) {
        backToTop.classList.add('is-visible');
      } else {
        backToTop.classList.remove('is-visible');
      }
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(toggleVisibility);
        ticking = true;
      }
    }, { passive: true });
    toggleVisibility();
  })();

  (function () {
    document.querySelectorAll('img[data-astro-image]').forEach((img) => {
      const markLoaded = () => img.classList.add('is-loaded');
      if (img.complete) {
        markLoaded();
      } else {
        img.addEventListener('load', markLoaded, { once: true });
        img.addEventListener('error', markLoaded, { once: true });
      }
    });
  })();
</script>

<style>
  .article-shell {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .article-header {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    animation: article-settle-in 560ms var(--ease-out-expo) both;
  }

  .article-kicker {
    margin: 0;
    color: color-mix(in oklab, var(--support) 78%, var(--fg-muted));
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
  }

  .article-title {
    margin: 0;
    font-size: clamp(2.1rem, 4.5vw, 3.6rem);
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: 0;
    line-height: 1.05;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 0.9rem;
    color: color-mix(in oklab, var(--support) 38%, var(--fg-muted));
    font-size: var(--text-sm);
  }

  .article-date {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .article-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--support-border) 60%, transparent);
    border-radius: 9999px;
    background: color-mix(in oklab, var(--support-soft) 50%, transparent);
    color: color-mix(in oklab, var(--support) 65%, var(--fg-muted));
    font-size: var(--text-xs);
    line-height: 1.5;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .article-tag:hover {
    background: color-mix(in oklab, var(--support-soft) 85%, transparent);
    border-color: color-mix(in oklab, var(--support-border) 90%, var(--border));
    color: var(--support);
  }

  .article-footer {
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    max-width: var(--content-width);
    margin: 2rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .nav-prev,
  .nav-next {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    text-decoration: none;
    position: relative;
  }

  .nav-next {
    text-align: right;
  }

  .nav-label {
    color: color-mix(in oklab, var(--support) 72%, var(--fg-subtle));
    font-size: var(--text-xs);
    font-family: var(--font-sans);
