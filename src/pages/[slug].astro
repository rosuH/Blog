---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import Bio from '../components/Bio.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sorted[index + 1] ?? null,
      nextPost: sorted[index - 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description || post.data.excerpt}
  image={post.data.hero}
  article={true}
>
  <div id="reading-progress" aria-hidden="true"></div>

  <article itemscope itemtype="http://schema.org/BlogPosting">
    <header class="article-header" data-reveal="article-header">
      <h1 itemprop="headline">{post.data.title}</h1>
      <div class="article-meta">
        <time
          datetime={post.data.date.toISOString()}
          itemprop="datePublished"
        >
          {post.data.date.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {(post.data.tags ?? []).length > 0 && (
          <div class="article-tags" role="list" aria-label="文章标签">
            {post.data.tags.map((tag) => (
              <span class="article-tag" role="listitem">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <section class="prose" itemprop="articleBody">
      <Content />
    </section>

    <footer class="article-footer">
      <Bio compact={true} />
    </footer>
  </article>

  {(prevPost || nextPost) && (
    <nav class="post-nav" aria-label="文章导航">
      <div>
        {prevPost && (
          <a href={`/${prevPost.id}/`} rel="prev" class="nav-prev">
            <span class="nav-label">上一篇</span>
            <span class="nav-title">{prevPost.data.title}</span>
          </a>
        )}
      </div>
      <div>
        {nextPost && (
          <a href={`/${nextPost.id}/`} rel="next" class="nav-next">
            <span class="nav-label">下一篇</span>
            <span class="nav-title">{nextPost.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  )}
</Layout>

<script>
  (function () {
    const bar = document.getElementById('reading-progress') as HTMLElement | null;
    const article = document.querySelector('article') as HTMLElement | null;
    if (!bar || !article) return;

    let ticking = false;

    function update() {
      const { top, height } = article.getBoundingClientRect();
      const scrollable = height - window.innerHeight;
      const progress = scrollable > 0 ? Math.max(0, Math.min(1, -top / scrollable)) : 0;
      bar.style.transform = `scaleX(${progress})`;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });

    update();
  })();

  (function () {
    if (!navigator.clipboard) return;

    const copyIcon = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    const checkIcon = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 12 4 9"/></svg>`;
    const copiedLabel = '已复制';

    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const button = document.createElement('button');
      button.className = 'copy-btn';
      button.setAttribute('aria-label', '复制代码');
      button.setAttribute('data-copied-label', copiedLabel);
      button.innerHTML = copyIcon;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        try {
          await navigator.clipboard.writeText(code?.innerText ?? '');
          button.innerHTML = checkIcon;
          button.classList.add('copied');
          setTimeout(() => {
            button.innerHTML = copyIcon;
            button.classList.remove('copied');
          }, 1500);
        } catch {
          // Clipboard API unavailable or denied — fail silently
        }
      });

      wrapper.appendChild(button);
    });
  })();
</script>

<style>
  .article-header {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 2.5rem;
    animation: article-settle-in 560ms var(--ease-out-expo) both;
  }

  .article-header h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    color: color-mix(in oklab, var(--support) 38%, var(--fg-muted));
    font-size: var(--text-sm);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-tag {
    padding: 0.18rem 0.55rem;
    border: 1px solid color-mix(in oklab, var(--support-border) 76%, var(--border));
    border-radius: 999px;
    background: color-mix(in oklab, var(--support-soft) 82%, transparent);
    color: var(--support);
    font-size: var(--text-xs);
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .post-nav > div {
    flex: 1;
  }

  .nav-prev,
  .nav-next {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
    position: relative;
  }

  .nav-next {
    text-align: right;
  }

  .nav-label {
    color: color-mix(in oklab, var(--support) 72%, var(--fg-subtle));
    font-size: var(--text-xs);
    font-family: var(--font-sans);
  }

  .nav-title {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.5;
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .nav-prev:hover .nav-title,
  .nav-next:hover .nav-title,
  .nav-prev:focus-visible .nav-title,
  .nav-next:focus-visible .nav-title {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .nav-prev::after,
  .nav-next::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.1rem;
    height: 1px;
    background: color-mix(in srgb, var(--accent) 50%, transparent);
    transform: scaleX(0);
    transition: transform var(--duration-medium) var(--ease-out-quart);
  }

  .nav-prev::after {
    transform-origin: left;
  }

  .nav-next::after {
    transform-origin: right;
  }

  .nav-prev:hover::after,
  .nav-next:hover::after,
  .nav-prev:focus-visible::after,
  .nav-next:focus-visible::after {
    transform: scaleX(1);
  }

  @keyframes article-settle-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .article-header {
      margin-bottom: 2rem;
    }

    .post-nav {
      flex-direction: column;
    }

    .nav-next {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-header {
      animation: none;
    }

    .nav-title,
    .nav-prev::after,
    .nav-next::after {
      transition: none;
    }
  }
</style>
