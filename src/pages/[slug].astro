---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import Bio from '../components/Bio.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sorted[index + 1] ?? null, // older post
      nextPost: sorted[index - 1] ?? null, // newer post
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description || post.data.excerpt}
  image={post.data.hero}
  article={true}
>
  <!-- Reading progress: fixed bar, scoped to article scroll depth -->
  <div id="reading-progress" aria-hidden="true"></div>

  <!-- Dynamic Island: floating pill in header showing section + progress -->
  <div id="dynamic-island" aria-hidden="true">
    <span class="di-dot"></span>
    <span class="di-text"></span>
  </div>
  <article itemscope itemtype="http://schema.org/BlogPosting">
    <header class="article-header">
      <h1 itemprop="headline">{post.data.title}</h1>
      <div class="article-meta">
        <time
          datetime={post.data.date.toISOString()}
          itemprop="datePublished"
        >
          {post.data.date.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {(post.data.tags ?? []).length > 0 && (
          <>
            <span class="meta-sep">·</span>
            <div class="article-tags" role="list">
              {post.data.tags.map((tag) => (
                <span class="article-tag" role="listitem">{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    <section class="prose" itemprop="articleBody">
      <Content />
    </section>

    <footer class="article-footer">
      <Bio compact={true} />
    </footer>
  </article>

  {(prevPost || nextPost) && (
    <nav class="post-nav" aria-label="Article navigation">
      <div>
        {prevPost && (
          <a href={`/${prevPost.id}/`} rel="prev" class="nav-prev">
            <span class="nav-label">Earlier</span>
            <span class="nav-title">{prevPost.data.title}</span>
          </a>
        )}
      </div>
      <div>
        {nextPost && (
          <a href={`/${nextPost.id}/`} rel="next" class="nav-next">
            <span class="nav-label">Later</span>
            <span class="nav-title">{nextPost.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  )}
</Layout>

<script>
// ── Reading Progress Bar ──────────────────────────────────────────────────────
// Scoped to <article> element so progress reaches 100% at article end,
// not at page bottom (which includes footer/nav).
(function () {
  const bar = document.getElementById('reading-progress') as HTMLElement | null;
  const article = document.querySelector('article') as HTMLElement | null;
  if (!bar || !article) return;

  let ticking = false;

  function update() {
    const { top, height } = article.getBoundingClientRect();
    const scrollable = height - window.innerHeight;
    const progress = scrollable > 0 ? Math.max(0, Math.min(1, -top / scrollable)) : 0;
    bar.style.transform = `scaleX(${progress})`;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  }, { passive: true });

  update(); // set initial state
})();

// ── Code Block Copy Button ────────────────────────────────────────────────────
// Wraps each <pre> in a .code-wrapper div (outside overflow context) so the
// absolutely-positioned button isn't clipped by overflow-x: auto on <pre>.
(function () {
  if (!navigator.clipboard) return;

  const ICON_COPY = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
  const ICON_CHECK = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 12 4 9"/></svg>`;

  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    // Wrap pre in a relative-positioned div so button escapes overflow clipping
    const wrapper = document.createElement('div');
    wrapper.className = 'code-wrapper';
    pre.parentNode!.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', 'Copy code');
    btn.innerHTML = ICON_COPY;

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      try {
        await navigator.clipboard.writeText(code?.innerText ?? '');
        btn.innerHTML = ICON_CHECK;
        btn.classList.add('copied');
        setTimeout(() => {
          btn.innerHTML = ICON_COPY;
          btn.classList.remove('copied');
        }, 1500);
      } catch {
        // Clipboard API unavailable or denied — fail silently
      }
    });

    wrapper.appendChild(btn);
  });
})();

// ── Dynamic Island ────────────────────────────────────────────────────────────
// Morphing pill in the header center: shows current section + scroll progress.
// Appears when scrolling, auto-hides 2.5s after the last scroll event.
(function () {
  const island = document.getElementById('dynamic-island') as HTMLElement | null;
  if (!island) return;

  const textEl = island.querySelector<HTMLElement>('.di-text');
  const article = document.querySelector('article') as HTMLElement | null;
  if (!textEl || !article) return;

  let hideTimer: ReturnType<typeof setTimeout>;
  let currentSection = '';

  // Track which H2/H3 is currently in the upper portion of the viewport
  const headings = document.querySelectorAll<HTMLElement>('.prose h2, .prose h3');
  if (headings.length > 0) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const text = entry.target.textContent?.trim() ?? '';
            currentSection = text.length > 18 ? text.slice(0, 18) + '…' : text;
          }
        });
      },
      { rootMargin: '-5% 0px -85% 0px' }
    );
    headings.forEach((h) => sectionObserver.observe(h));
  }

  window.addEventListener(
    'scroll',
    () => {
      const { top, height } = article.getBoundingClientRect();
      const scrollable = height - window.innerHeight;
      if (scrollable <= 0) return;

      const pct = Math.round(Math.max(0, Math.min(100, (-top / scrollable) * 100)));

      if (pct > 1 && pct < 99) {
        const prefix = currentSection ? `${currentSection} · ` : '';
        textEl.textContent = `${prefix}${pct}%`;
        island.classList.add('is-visible');
      } else {
        island.classList.remove('is-visible');
      }

      // Collapse after 2.5s of inactivity
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => island.classList.remove('is-visible'), 2500);
    },
    { passive: true }
  );
})();

// ── Paragraph Scroll Reveal ───────────────────────────────────────────────────
// Elements below the fold fade up as they enter the viewport.
// Elements already visible on load are left untouched (no FOIC).
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const selector =
    '.prose p, .prose h2, .prose h3, .prose h4, .prose pre, .prose blockquote, .prose ul, .prose ol';
  const elements = document.querySelectorAll<HTMLElement>(selector);
  const viewportH = window.innerHeight;

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('reveal-pending');
          entry.target.classList.add('reveal-done');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
  );

  elements.forEach((el) => {
    // Only hide elements not yet visible in the initial viewport
    if (el.getBoundingClientRect().top > viewportH * 0.88) {
      el.classList.add('reveal-pending');
      observer.observe(el);
    }
  });
})();
</script>

<style>
  .article-header {
    margin-bottom: 3rem;
  }

  .article-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .meta-sep {
    color: var(--fg-subtle);
  }

  .article-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .article-tag {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    border: 1px solid var(--border);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .post-nav > div {
    flex: 1;
  }

  .nav-prev,
  .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-next {
    text-align: right;
  }

  .nav-label {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-title {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    font-weight: 500;
    transition: color 0.15s;
  }

  .nav-prev:hover .nav-title,
  .nav-next:hover .nav-title {
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .article-header h1 {
      font-size: var(--text-2xl);
    }

    .post-nav {
      flex-direction: column;
    }

    .nav-next {
      text-align: left;
    }
  }

  /* ── Dynamic Island ──────────────────────────────────────────────────────── */
  #dynamic-island {
    position: fixed;
    top: 1.75rem;
    left: 50%;
    /* Two-state transform: centered + entrance offset when hidden */
    transform: translateX(-50%) scale(0.88) translateY(-4px);

    display: flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;

    background: var(--fg);
    color: var(--bg);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;

    font-size: 0.6875rem; /* 11px */
    font-family: var(--font-mono);
    letter-spacing: 0.01em;

    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);

    z-index: 90;
  }

  #dynamic-island.is-visible {
    opacity: 1;
    transform: translateX(-50%) scale(1) translateY(0);
  }

  .di-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    animation: di-pulse 2s ease-in-out infinite;
  }

  @keyframes di-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  /* ── Paragraph Scroll Reveal ─────────────────────────────────────────────── */
  .reveal-pending {
    opacity: 0;
    transform: translateY(7px);
    transition:
      opacity 0.45s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-done {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.45s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }</style>
