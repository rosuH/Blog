---
// src/layouts/Layout.astro
import '../styles/global.css';
import { Font } from 'astro:assets';
import DarkMode from '../components/DarkMode.astro';
import DitherScene from '../components/DitherScene.astro';
import { SITE } from '../utils/site-info';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  math?: boolean;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image,
  article = false,
  math = false,
  robots = 'index,follow',
  structuredData,
} = Astro.props;
// Use site root as base; fall back to request origin (not page URL) in dev
const siteBase = Astro.site ?? new URL('/', Astro.url);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const metaDescription = description || SITE.description;
// Default share card: warm paper + dither cloud/tree (1200×630). Bust caches when art changes.
const defaultOgImagePath = '/seo-og-image.jpg?v=dither-2026-08';
const usingDefaultOgImage = !image;
const ogImage = new URL(image || defaultOgImagePath, siteBase).toString();
const ogImageAlt = usingDefaultOgImage
  ? `${SITE.alternateName} — ${SITE.description}`
  : title;
const pageTitle = `${title} | ${SITE.name}`;
const structuredDataItems = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const serializeStructuredData = (item: Record<string, unknown>) =>
  JSON.stringify(item).replaceAll('<', '\\u003c');
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />

    <!-- Theme and first-paint background must run before stylesheet discovery.
         data-cfasync="false" keeps Cloudflare Rocket Loader from rewriting/deferring
         this script (it otherwise changes type to "*-text/javascript" and FOUCs dark mode). -->
    <script is:inline data-critical-theme-init data-cfasync="false">
      (() => {
        const root = document.documentElement;
        const lightBg = 'oklch(98% 0.006 85)';
        const darkBg = 'oklch(18.5% 0.012 252)';
        const apply = (isDark) => {
          root.classList.toggle('dark', isDark);
          root.dataset.theme = isDark ? 'dark' : 'light';
          root.style.colorScheme = isDark ? 'dark' : 'light';
          // Inline bg covers the gap before the following critical <style> is applied.
          root.style.backgroundColor = isDark ? darkBg : lightBg;
        };
        try {
          const stored = window.localStorage?.getItem('theme');
          const theme = stored === 'dark' || stored === 'light'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          apply(theme === 'dark');
        } catch {
          try {
            apply(window.matchMedia('(prefers-color-scheme: dark)').matches);
          } catch {
            apply(false);
          }
        }

        // 这面墙有时间：按读者本地时刻给 <html> 标注时段，CSS 据此微调光色。
        const hour = new Date().getHours();
        if (hour >= 5 && hour < 11) root.dataset.daytime = 'morning';
        else if (hour >= 16 && hour < 19) root.dataset.daytime = 'dusk';
      })();
    </script>
    <style is:inline data-critical-page-background>
      :root {
        background-color: oklch(98% 0.006 85);
        color-scheme: light;
      }

      /* Prefer system dark before/without JS (e.g. if a proxy defers the init script). */
      @media (prefers-color-scheme: dark) {
        html:not([data-theme='light']) {
          background-color: oklch(18.5% 0.012 252);
          color-scheme: dark;
        }

        html:not([data-theme='light']),
        html:not([data-theme='light']) body {
          background-color: oklch(18.5% 0.012 252);
        }
      }

      html,
      body {
        min-height: 100%;
        background-color: oklch(98% 0.006 85);
      }

      html.dark,
      html[data-theme='dark'],
      html.dark body,
      html[data-theme='dark'] body {
        background-color: oklch(18.5% 0.012 252);
        color-scheme: dark;
      }

      html[data-theme='light'],
      html[data-theme='light'] body {
        background-color: oklch(98% 0.006 85);
        color-scheme: light;
      }
    </style>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=avatar" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=avatar" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=avatar" />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={metaDescription} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {usingDefaultOgImage && (
      <>
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rosu_h" />
    <meta name="twitter:creator" content="@rosu_h" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={serializeStructuredData(item)} />
    ))}

    <!-- Self-hosted, subset Latin fonts (see experimental.fonts in astro.config).
         No preload: LCP text is Chinese (system CJK), so preloading Latin webfonts
         would compete with LCP for glyphs that only style minor Latin runs. -->
    <Font cssVariable="--font-outfit" />
    <Font cssVariable="--font-ibm-plex-serif" />
    <Font cssVariable="--font-jetbrains-mono" />

    <!-- KaTeX CSS (math posts only, self-hosted — no third-party render-blocking) -->
    {math && (
      <link rel="stylesheet" href="/katex/katex.min.css" />
    )}

    <!-- Deferred analytics bootstrap -->
    {import.meta.env.PROD && (
      <script is:inline>
        const analyticsId = 'G-1F0F92B00T';
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', analyticsId);

        const loadAnalytics = () => {
          if (document.querySelector(`script[data-analytics-id="${analyticsId}"]`)) return;
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`;
          script.dataset.analyticsId = analyticsId;
          document.head.appendChild(script);
        };

        const scheduleAnalytics = () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadAnalytics, { timeout: 2000 });
          } else {
            window.setTimeout(loadAnalytics, 1200);
          }
        };

        if (document.readyState === 'complete') {
          scheduleAnalytics();
        } else {
          window.addEventListener('load', scheduleAnalytics, { once: true });
        }
      </script>
    )}

    <!-- Live Photo styles (no-op when no .livephoto exists on the page) -->
    <style is:global>
      .livephoto {
        position: relative;
        margin: 0;
        overflow: hidden;
        border-radius: 4px;
        background: var(--code-bg);
      }
      .livephoto picture,
      .livephoto picture img,
      .livephoto-video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .livephoto-video {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.18s ease-out;
        pointer-events: none;
      }
      .livephoto[data-state="playing"] picture {
        opacity: 0;
        transition: opacity 0.18s ease-out;
      }
      .livephoto[data-state="playing"] .livephoto-video {
        opacity: 1;
      }
      .livephoto-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px 4px 8px;
        border: 0;
        border-radius: 999px;
        background: color-mix(in oklab, var(--fg) 72%, transparent);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        color: var(--bg);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        cursor: pointer;
        user-select: none;
        z-index: 3;
      }
      html.dark .livephoto-badge {
        background: color-mix(in oklab, var(--fg) 78%, transparent);
        color: var(--bg);
      }
      .livephoto-badge:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .livephoto[data-state="playing"] .livephoto-dot {
        animation: livephoto-pulse 1.4s ease-in-out infinite;
      }
      @keyframes livephoto-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
      }
      @media (prefers-reduced-motion: reduce) {
        .livephoto[data-state="playing"] picture,
        .livephoto-video {
          transition: none;
        }
        .livephoto[data-state="playing"] .livephoto-dot {
          animation: none;
        }
      }
    </style>
  </head>

  <body>
    <a href="#main-content" class="skip-link">跳转到内容</a>
    <DitherScene article={article} />
    <div class="site-wrap">
      <header class="site-header">
        <a href="/" class="site-logo">Blog.kt</a>
        <DarkMode />
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <p>© 2016–{new Date().getFullYear()} · 使用 <a href="https://astro.build">Astro</a> 构建</p>
      </footer>
    </div>

    <!-- Live Photo behavior (no-op when no [data-livephoto] on page) -->
    <script is:inline>
      (function () {
        if (window.__livephotoBound) return;
        window.__livephotoBound = true;
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll('[data-livephoto]').forEach((fig) => {
          const video = fig.querySelector('[data-lp-video]');
          const badge = fig.querySelector('.livephoto-badge');
          if (!video || !badge) return;
          let pressTimer = 0;
          const start = () => {
            if (fig.dataset.state === 'playing') return;
            fig.dataset.state = 'playing';
            try { video.currentTime = 0; } catch (e) {}
            const p = video.play();
            if (p && p.catch) p.catch(() => { fig.dataset.state = 'idle'; });
          };
          const stop = () => {
            video.pause();
            try { video.currentTime = 0; } catch (e) {}
            fig.dataset.state = 'idle';
          };
          video.addEventListener('ended', stop);

          if (reduce) {
            // In reduced-motion mode, hover/long-press auto-play is suppressed
            // and the badge becomes the primary click target. Update the label
            // to reflect that behavior for screen-reader and keyboard users.
            badge.setAttribute('aria-label', 'Live Photo — 点击播放');
            badge.addEventListener('click', () => {
              fig.dataset.state === 'playing' ? stop() : start();
            });
          } else {
            fig.addEventListener('mouseenter', start);
            fig.addEventListener('mouseleave', stop);
            badge.addEventListener('click', (e) => {
              e.preventDefault();
              start();
            });
            fig.addEventListener('pointerdown', (e) => {
              if (e.pointerType !== 'touch') return;
              pressTimer = setTimeout(start, 200);
            });
            ['pointerup', 'pointercancel', 'pointerleave'].forEach((ev) => {
              fig.addEventListener(ev, (e) => {
                if (e.pointerType !== 'touch') return;
                clearTimeout(pressTimer);
                stop();
              });
            });
            badge.addEventListener('keydown', (e) => {
              if (e.key === ' ' || e.key === 'Enter') {
                e.preventDefault();
                fig.dataset.state === 'playing' ? stop() : start();
              }
            });
          }

          const io = new IntersectionObserver(([entry]) => {
            if (!entry.isIntersecting && fig.dataset.state === 'playing') stop();
          }, { rootMargin: '200px' });
          io.observe(fig);
        });
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 50%;
    transform: translate(-50%, -150%);
    z-index: 1000;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: 999px;
    transition: transform 0.18s ease;
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    transform: translate(-50%, 0);
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .site-header {
    padding: 1.25rem 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .site-logo {
    font-size: var(--text-sm);
    font-weight: 500;
    font-family: var(--font-display);
    color: var(--fg);
    letter-spacing: 0;
    transition: color 0.15s;
  }

  .site-logo:hover {
    color: var(--fg-muted);
  }

  .site-footer {
    padding: 2.5rem 0 2rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .site-footer a {
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .site-footer a:hover {
    color: var(--sun);
  }
</style>
