---
// src/components/DarkMode.astro
// Flat control + Bayer-dither pixel icons (matches cloud/tree scene language).
---

<button
  id="theme-toggle"
  aria-label="切换明暗主题"
  class="theme-toggle"
  type="button"
  data-label-light="切换到浅色模式"
  data-label-dark="切换到深色模式"
>
  <!-- Sun: shown in dark mode (click to go light). 16×16 pixel dither disc + rays. -->
  <svg
    class="sun-icon"
    width="16"
    height="16"
    viewBox="0 0 16 16"
    fill="currentColor"
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    <!-- rays (single-pixel ticks) -->
    <rect x="7" y="0" width="2" height="2" />
    <rect x="7" y="14" width="2" height="2" />
    <rect x="0" y="7" width="2" height="2" />
    <rect x="14" y="7" width="2" height="2" />
    <rect x="2" y="2" width="2" height="2" />
    <rect x="12" y="2" width="2" height="2" />
    <rect x="2" y="12" width="2" height="2" />
    <rect x="12" y="12" width="2" height="2" />
    <!-- disc with Bayer-ish checker fill (not solid blob) -->
    <rect x="5" y="4" width="2" height="2" />
    <rect x="9" y="4" width="2" height="2" />
    <rect x="4" y="5" width="2" height="2" />
    <rect x="7" y="5" width="2" height="2" />
    <rect x="10" y="5" width="2" height="2" />
    <rect x="5" y="6" width="2" height="2" />
    <rect x="9" y="6" width="2" height="2" />
    <rect x="4" y="7" width="2" height="2" />
    <rect x="7" y="7" width="2" height="2" />
    <rect x="10" y="7" width="2" height="2" />
    <rect x="5" y="8" width="2" height="2" />
    <rect x="9" y="8" width="2" height="2" />
    <rect x="4" y="9" width="2" height="2" />
    <rect x="7" y="9" width="2" height="2" />
    <rect x="10" y="9" width="2" height="2" />
    <rect x="5" y="10" width="2" height="2" />
    <rect x="9" y="10" width="2" height="2" />
  </svg>
  <!-- Moon: shown in light mode (click to go dark). Crescent via dither pixels. -->
  <svg
    class="moon-icon"
    width="16"
    height="16"
    viewBox="0 0 16 16"
    fill="currentColor"
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    <!-- outer crescent arc (right-heavy) -->
    <rect x="8" y="2" width="2" height="2" />
    <rect x="10" y="2" width="2" height="2" />
    <rect x="6" y="3" width="2" height="2" />
    <rect x="11" y="3" width="2" height="2" />
    <rect x="5" y="4" width="2" height="2" />
    <rect x="12" y="4" width="2" height="2" />
    <rect x="4" y="5" width="2" height="2" />
    <rect x="12" y="5" width="2" height="2" />
    <rect x="4" y="6" width="2" height="2" />
    <rect x="13" y="6" width="2" height="2" />
    <rect x="4" y="7" width="2" height="2" />
    <rect x="13" y="7" width="2" height="2" />
    <rect x="4" y="8" width="2" height="2" />
    <rect x="13" y="8" width="2" height="2" />
    <rect x="4" y="9" width="2" height="2" />
    <rect x="12" y="9" width="2" height="2" />
    <rect x="5" y="10" width="2" height="2" />
    <rect x="12" y="10" width="2" height="2" />
    <rect x="6" y="11" width="2" height="2" />
    <rect x="11" y="11" width="2" height="2" />
    <rect x="8" y="12" width="2" height="2" />
    <rect x="10" y="12" width="2" height="2" />
    <!-- dither “fill” on the lit rim -->
    <rect x="9" y="4" width="2" height="2" />
    <rect x="10" y="6" width="2" height="2" />
    <rect x="10" y="8" width="2" height="2" />
    <rect x="9" y="10" width="2" height="2" />
  </svg>
</button>

<style>
  .theme-toggle {
    background: transparent;
    border: none;
    box-shadow: none;
    cursor: pointer;
    padding: 0;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--fg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-quiet);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .theme-toggle:hover {
    color: var(--sun);
    transform: translateY(-1px);
  }

  .theme-toggle:active {
    transform: translateY(0);
  }

  .theme-toggle:focus-visible {
    outline-offset: 3px;
  }

  .theme-toggle::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-quiet) var(--ease-quiet);
  }

  .theme-toggle.is-toggling::after {
    opacity: 0.72;
    transform: scale(1.06);
  }

  .sun-icon,
  .moon-icon {
    position: absolute;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    image-rendering: pixelated;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-quiet) var(--ease-quiet);
  }

  .sun-icon {
    opacity: 0;
    transform: rotate(-8deg) scale(0.9);
  }

  .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.dark) .sun-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.dark) .moon-icon {
    opacity: 0;
    transform: rotate(8deg) scale(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle::after,
    .sun-icon,
    .moon-icon {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const applyThemeLabel = (isDark) => {
    if (!toggle) return;
    const nextLabel = isDark
      ? toggle.dataset.labelLight ?? '切换到浅色模式'
      : toggle.dataset.labelDark ?? '切换到深色模式';

    toggle.setAttribute('aria-label', nextLabel);
    toggle.setAttribute('title', nextLabel);
    toggle.setAttribute('aria-pressed', String(isDark));
  };

  const isDark = document.documentElement.classList.contains('dark');
  applyThemeLabel(isDark);

  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    root.classList.add('theme-animating');
    const nextIsDark = root.classList.toggle('dark');
    root.dataset.theme = nextIsDark ? 'dark' : 'light';
    root.style.colorScheme = nextIsDark ? 'dark' : 'light';
    root.style.backgroundColor = nextIsDark
      ? 'oklch(18.5% 0.012 252)'
      : 'oklch(98% 0.006 85)';
    localStorage.setItem('theme', nextIsDark ? 'dark' : 'light');
    applyThemeLabel(nextIsDark);

    toggle.classList.remove('is-toggling');
    void toggle.offsetWidth;
    toggle.classList.add('is-toggling');
    setTimeout(() => {
      toggle.classList.remove('is-toggling');
      root.classList.remove('theme-animating');
    }, 320);
  });
</script>
