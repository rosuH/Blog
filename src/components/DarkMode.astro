---
// src/components/DarkMode.astro
---

<button
  id="theme-toggle"
  aria-label="切换明暗主题"
  class="theme-toggle"
  type="button"
  data-label-light="切换到浅色模式"
  data-label-dark="切换到深色模式"
>
  <!-- Sun: shown in dark mode (click to go light) -->
  <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5"/>
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
  </svg>
  <!-- Moon: shown in light mode (click to go dark) -->
  <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<style>
  .theme-toggle {
    background: color-mix(in srgb, var(--bg) 88%, var(--accent) 12%);
    border: 1px solid var(--border);
    cursor: pointer;
    padding: 0;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--fg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .theme-toggle:hover {
    color: var(--fg);
    border-color: color-mix(in srgb, var(--accent) 22%, var(--border));
  }

  .theme-toggle:focus-visible {
    outline-offset: 3px;
  }

  .theme-toggle::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    opacity: 0;
    transform: scale(0.72);
    transition: opacity var(--duration-fast) ease, transform var(--duration-medium) var(--ease-out-quart);
  }

  .theme-toggle.is-toggling::after {
    opacity: 1;
    transform: scale(1.2);
  }

  .sun-icon,
  .moon-icon {
    position: absolute;
    z-index: 1;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-medium) var(--ease-out-quart);
  }

  .sun-icon  {
    opacity: 0;
    transform: rotate(-24deg) scale(0.72);
  }

  .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.dark) .sun-icon  {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.dark) .moon-icon {
    opacity: 0;
    transform: rotate(24deg) scale(0.72);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle::after,
    .sun-icon,
    .moon-icon {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const applyThemeLabel = (isDark) => {
    if (!toggle) return;
    const nextLabel = isDark
      ? toggle.dataset.labelLight ?? '切换到浅色模式'
      : toggle.dataset.labelDark ?? '切换到深色模式';

    toggle.setAttribute('aria-label', nextLabel);
    toggle.setAttribute('title', nextLabel);
    toggle.setAttribute('aria-pressed', String(isDark));
  };

  const isDark = document.documentElement.classList.contains('dark');
  applyThemeLabel(isDark);

  toggle?.addEventListener('click', () => {
    const nextIsDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', nextIsDark ? 'dark' : 'light');
    applyThemeLabel(nextIsDark);

    toggle.classList.remove('is-toggling');
    void toggle.offsetWidth;
    toggle.classList.add('is-toggling');
    setTimeout(() => toggle.classList.remove('is-toggling'), 420);
  });
</script>
