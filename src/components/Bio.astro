---
// src/components/Bio.astro
import { getImage } from 'astro:assets';
import profilePic from '../images/profile-pic.png';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

// Display size is small (56/42), but line-art avatars look soft if we only
// ship 1× pixels. Bake 3× WebP once from a lossless PNG master and let CSS
// scale it down — sharp on retina, no AVIF mush, no double-lossy chain.
const display = compact ? 42 : 56;
const avatar = await getImage({
  src: profilePic,
  width: display * 3,
  height: display * 3,
  format: 'webp',
  quality: 100,
});
---

<div class:list={['bio', { 'bio--compact': compact }]}>
  <img
    src={avatar.src}
    width={display}
    height={display}
    alt="rosu"
    class="bio-avatar"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="bio-copy">
    <p class="bio-line">
      <span class="bio-name">rosu</span>
    </p>
    <nav class="bio-links" aria-label="作者链接">
      <a href="https://rosuh.me" aria-label="站点" title="站点" class="bio-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M3 12h18"/>
          <path d="M12 3a14 14 0 0 1 0 18"/>
          <path d="M12 3a14 14 0 0 0 0 18"/>
        </svg>
      </a>
      <a href="https://github.com/rosuH" aria-label="GitHub" title="GitHub" class="bio-link">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .6A12 12 0 0 0 8.2 24c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.8 1.2 1.8 1.2 1 1.7 2.6 1.2 3.3.9.1-.7.4-1.2.7-1.5-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.4.1-3 0 0 1-.3 3.2 1.2a10.8 10.8 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.7.1 3 .8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.3.8 1 .8 2v3c0 .3.2.7.8.6A12 12 0 0 0 12 .6Z"/>
        </svg>
      </a>
      <a href="https://twitter.com/rosu_h" aria-label="X" title="X" class="bio-link">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.2 2.25h3.2l-7 8 8.2 11.5h-6.4l-4.8-6.5-5.7 6.5H2.5l7.5-8.6L2 2.25h6.5l4.3 5.8 5.4-5.8Z"/>
        </svg>
      </a>
    </nav>
  </div>
</div>

<style>
  .bio {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.875rem;
  }

  .bio--compact {
    gap: 0.75rem;
    margin-bottom: 0;
  }

  .bio-avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
    background: var(--paper);
    box-shadow:
      0 0 0 2px var(--bg),
      var(--lift-shadow);
    transition:
      box-shadow var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-quiet);
  }

  .bio--compact .bio-avatar {
    width: 2.625rem;
    height: 2.625rem;
  }

  .bio-avatar:hover {
    box-shadow:
      0 0 0 2px var(--bg),
      -3px 8px 20px rgb(64 52 28 / 0.2);
    transform: translateY(-2px);
  }

  .bio-copy {
    min-width: 0;
    flex: 0 1 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
  }

  .bio-line {
    margin: 0;
    min-width: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .bio-name {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
  }

  .bio-links {
    margin-left: 0.2rem;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.125rem;
    align-items: center;
  }

  .bio-link {
    min-height: 2.75rem;
    min-width: 2.75rem;
    display: inline-grid;
    place-items: center;
    align-items: center;
    color: color-mix(in oklab, var(--fg-muted) 76%, var(--fg));
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-quiet);
  }

  .bio-link:hover {
    color: var(--sun);
    transform: translateY(-2px);
  }

  .bio-link svg {
    display: block;
    width: 0.82rem;
    height: 0.82rem;
  }

  .bio--compact .bio-copy {
    gap: 0.125rem 0.4rem;
  }

  .bio--compact .bio-link {
    min-height: 2.75rem;
    min-width: 2.75rem;
  }

  @media (max-width: 560px) {
    .bio {
      align-items: flex-start;
      gap: 0.875rem;
    }

    .bio-copy {
      display: grid;
      gap: 0.2rem;
    }

    .bio-links {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-avatar,
    .bio-link {
      transition: none;
    }

    .bio-avatar:hover,
    .bio-link:hover {
      transform: none;
    }
  }
</style>
