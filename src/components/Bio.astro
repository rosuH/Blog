---
// src/components/Bio.astro
import { Image } from 'astro:assets';
import profilePic from '../images/profile-pic.png';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['bio', { 'bio--compact': compact }]}>
  <Image
    src={profilePic}
    alt="rosu"
    width={compact ? 40 : 48}
    height={compact ? 40 : 48}
    layout="fixed"
    densities={[1, 2, 3]}
    class="bio-avatar"
    loading="eager"
    quality={95}
  />
  <div class="bio-copy">
    <p class="bio-line">
      <span class="bio-name">rosu</span>
    </p>
    <nav class="bio-links" aria-label="作者链接">
      <a href="https://rosuh.me" aria-label="站点" title="站点" class="bio-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M3 12h18"/>
          <path d="M12 3a14 14 0 0 1 0 18"/>
          <path d="M12 3a14 14 0 0 0 0 18"/>
        </svg>
      </a>
      <a href="https://github.com/rosuH" aria-label="GitHub" title="GitHub" class="bio-link">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .6A12 12 0 0 0 8.2 24c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.8 1.2 1.8 1.2 1 1.7 2.6 1.2 3.3.9.1-.7.4-1.2.7-1.5-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.4.1-3 0 0 1-.3 3.2 1.2a10.8 10.8 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.7.1 3 .8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.3.8 1 .8 2v3c0 .3.2.7.8.6A12 12 0 0 0 12 .6Z"/>
        </svg>
      </a>
      <a href="https://twitter.com/rosu_h" aria-label="X" title="X" class="bio-link">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.2 2.25h3.2l-7 8 8.2 11.5h-6.4l-4.8-6.5-5.7 6.5H2.5l7.5-8.6L2 2.25h6.5l4.3 5.8 5.4-5.8Z"/>
        </svg>
      </a>
    </nav>
  </div>
</div>

<style>
  .bio {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.875rem;
  }

  .bio--compact {
    gap: 0.75rem;
    margin-bottom: 0;
  }

  .bio-avatar {
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
  }

  .bio-copy {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
  }

  .bio-line {
    margin: 0;
    min-width: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .bio-name {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

.bio-links {
    margin-left: auto;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.125rem;
    align-items: center;
  }

  .bio-link {
    min-height: 2.5rem;
    min-width: 2.5rem;
    display: inline-grid;
    place-items: center;
    align-items: center;
    color: color-mix(in oklab, var(--fg-muted) 76%, var(--fg));
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .bio-link:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .bio-link svg {
    display: block;
    width: 0.82rem;
    height: 0.82rem;
  }

  .bio--compact .bio-copy {
    gap: 0.125rem 0.4rem;
  }

  .bio--compact .bio-link {
    min-height: 2.25rem;
    min-width: 2.25rem;
  }

  @media (max-width: 560px) {
    .bio {
      align-items: flex-start;
    }

    .bio-copy {
      display: grid;
      gap: 0.2rem;
    }

    .bio-links {
      margin-left: 0;
    }
  }
</style>
