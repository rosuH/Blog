---
// src/components/Bio.astro
import { Image } from 'astro:assets';
import profilePic from '../images/profile-pic.png';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['bio', { 'bio--compact': compact }]}>
  <Image
    src={profilePic}
    alt="rosu"
    width={compact ? 36 : 48}
    height={compact ? 36 : 48}
    densities={[1, 2, 3]}
    class="bio-avatar"
    loading="eager"
    quality={95}
  />
  <div class="bio-content">
    {!compact && <p class="bio-name">rosu</p>}
    <p class="bio-desc">{compact ? 'rosu · Android Developer' : 'Android Developer'}</p>
    <div class="bio-links">
      <a href="https://rosuh.me" aria-label="Website" class="bio-link">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
      </a>
      <a href="https://github.com/rosuH" aria-label="GitHub" class="bio-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </a>
      <a href="https://twitter.com/rosu_h" aria-label="Twitter / X" class="bio-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.63L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .bio {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 3rem;
  }

  .bio--compact {
    margin-bottom: 0;
  }

  .bio-avatar {
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
  }

  .bio-name {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.125rem;
    letter-spacing: -0.01em;
  }

  .bio-desc {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    margin: 0 0 0.5rem;
  }

  .bio--compact .bio-desc {
    margin-bottom: 0.375rem;
  }

  .bio-links {
    display: flex;
    gap: 0.625rem;
    align-items: center;
  }

  .bio-link {
    color: var(--fg-subtle);
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }

  .bio-link:hover {
    color: var(--accent);
  }
</style>

<script>
const CHARSET = 'abcdefghijklmnopqrstuvwxyz0123456789!@#?';

function scramble(el: HTMLElement, duration = 480): void {
  const target = el.textContent ?? '';
  const totalFrames = Math.round(duration / 40);
  let frame = 0;
  const timer = setInterval(() => {
    const resolved = Math.floor((frame / totalFrames) * target.length);
    el.textContent = target
      .split('')
      .map((ch, i) =>
        i < resolved ? ch : CHARSET[Math.floor(Math.random() * CHARSET.length)]
      )
      .join('');
    if (++frame > totalFrames) {
      clearInterval(timer);
      el.textContent = target;
    }
  }, 40);
}

const nameEl = document.querySelector<HTMLElement>('.bio-name');
if (nameEl) {
  scramble(nameEl);
  nameEl.addEventListener('mouseenter', () => scramble(nameEl));
}
</script>
