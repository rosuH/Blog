---
// Photo Bayer dither: top-left cloud + bottom-right palm/sea.
// WebP frames + ring-buffered ImageBitmaps; rAF only while tab is visible.
interface Props {
  article?: boolean;
}

const { article = false } = Astro.props;
const FRAME_COUNT = 36;
const FPS = 12;
const RING = 2;
const CLOUD_W = 720;
const CLOUD_H = 573;
const TREE_W = 1920;
const TREE_H = 670;
---

<div
  id="dither-scene"
  data-page-kind={article ? 'article' : 'home'}
  data-frame-count={FRAME_COUNT}
  data-fps={FPS}
  data-ring={RING}
  aria-hidden="true"
  role="presentation"
>
  <!--
    Night lighting (dark only):
      1. full moon disc (brightest lamp) behind cloud
      2. cloud/tree dither
      3. moonlight wash — radiates from moon centre only
  -->
  <div class="dither-moon">
    <span class="dither-moon__body"></span>
  </div>
  <canvas
    id="dither-cloud"
    class="dither-cloud"
    width={CLOUD_W}
    height={CLOUD_H}
  ></canvas>
  <canvas
    id="dither-tree"
    class="dither-tree"
    width={TREE_W}
    height={TREE_H}
  ></canvas>
  <!--
    One light field only: everything radiates from the moon centre.
    Sea/sand get residual intensity because they sit farther from that origin —
    never a second lamp in the bottom-right.
  -->
  <div class="dither-moonlight" aria-hidden="true"></div>
</div>

<style>
  #dither-scene {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    /* Disc top-left; light uses the geometric centre of the disc */
    --moon-x: clamp(4vw, 12vw, 8.5rem);
    --moon-y: max(1vh, 2.5vh);
    --moon-size: clamp(6.5rem, 14vw, 9.5rem);
    --moon-cx: calc(var(--moon-x) + var(--moon-size) * 0.5);
    --moon-cy: calc(var(--moon-y) + var(--moon-size) * 0.5);
  }

  /* --- Moon disc (behind cloud): soft, low-contrast --- */
  .dither-moon {
    position: absolute;
    top: var(--moon-y);
    left: var(--moon-x);
    width: var(--moon-size);
    height: var(--moon-size);
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.55s var(--ease-quiet, cubic-bezier(0.34, 0, 0.18, 1)),
      visibility 0.55s;
  }

  :global(html.dark) .dither-moon {
    opacity: 1;
    visibility: visible;
  }

  /*
    Full moon disc = brightest object (the lamp itself).
    Atmosphere wash stays dimmer than this core.
  */
  .dither-moon__body {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 32% 28%,
      oklch(97% 0.018 95 / 0.95) 0%,
      oklch(92% 0.022 93 / 0.88) 28%,
      oklch(82% 0.024 90 / 0.72) 58%,
      oklch(68% 0.02 86 / 0.52) 100%
    );
    box-shadow:
      0 0 0 1px oklch(96% 0.02 95 / 0.28),
      0 0 18px oklch(92% 0.03 92 / 0.45),
      0 0 40px oklch(84% 0.025 90 / 0.28),
      inset -5px -7px 14px oklch(40% 0.02 250 / 0.16);
    filter: blur(1.1px);
  }

  .dither-cloud {
    position: absolute;
    top: -6%;
    left: -8%;
    width: min(62vw, 760px);
    height: auto;
    aspect-ratio: 720 / 573;
    opacity: 0.95;
    image-rendering: pixelated;
    z-index: 2;
  }

  .dither-tree {
    position: absolute;
    right: 0;
    bottom: 0;
    height: min(72vh, 700px);
    width: auto;
    aspect-ratio: 1920 / 670;
    opacity: 0.9;
    image-rendering: pixelated;
    z-index: 2;
  }

  /*
    Single isotropic light field, origin = moon centre.
    Distance falloff only: cloud (near) bright, tree/sea/sand (far) residual.
  */
  .dither-moonlight {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.55s var(--ease-quiet, cubic-bezier(0.34, 0, 0.18, 1)),
      visibility 0.55s;
    /*
      Scene wash is secondary: peak alpha stays below the disc so the lamp
      reads brighter than its own halo. Falloff from moon centre only.
    */
    background: radial-gradient(
      circle at var(--moon-cx) var(--moon-cy),
      oklch(90% 0.024 92 / 0.42) 0%,
      oklch(84% 0.02 90 / 0.32) 12%,
      oklch(76% 0.018 90 / 0.22) 26%,
      oklch(68% 0.015 92 / 0.14) 42%,
      oklch(60% 0.012 95 / 0.09) 58%,
      oklch(54% 0.01 90 / 0.055) 74%,
      oklch(50% 0.008 88 / 0.03) 88%,
      transparent 100%
    );
    mix-blend-mode: soft-light;
    filter: blur(20px);
  }

  :global(html.dark) .dither-moonlight {
    opacity: 1;
    visibility: visible;
  }

  /* Near the source: cloud silhouette / brightness */
  :global(html.dark) .dither-cloud {
    opacity: 0.88;
    mix-blend-mode: soft-light;
  }

  /* Farther residual: tree + sea + sand */
  :global(html.dark) .dither-tree {
    opacity: 0.78;
    mix-blend-mode: soft-light;
  }

  @media (max-width: 720px) {
    .dither-cloud {
      width: 85vw;
      left: -12%;
    }
    .dither-tree {
      height: 52vh;
    }
    /* Article body needs room on phones: keep cloud, drop the sea/palm. */
    #dither-scene[data-page-kind='article'] .dither-tree {
      display: none;
    }
    #dither-scene {
      --moon-x: 5vw;
      --moon-y: 1vh;
      --moon-size: clamp(5rem, 26vw, 7.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dither-moon,
    .dither-moonlight {
      transition: none;
    }
  }
</style>


<script>
  (() => {
    const host = document.getElementById('dither-scene') as HTMLDivElement | null;
    const cloudEl = document.getElementById('dither-cloud') as HTMLCanvasElement | null;
    const treeEl = document.getElementById('dither-tree') as HTMLCanvasElement | null;
    if (!host || !cloudEl || !treeEl) return;

    // Mobile article: cloud only — skip tree decode/fetch for bandwidth + quieter reading.
    const enableTree = !(
      host.dataset.pageKind === 'article' &&
      window.matchMedia('(max-width: 720px)').matches
    );

    const N = Number(host.dataset.frameCount) || 36;
    const FPS = Number(host.dataset.fps) || 12;
    const RING = Number(host.dataset.ring) || 2;
    const CLOUD = { w: cloudEl.width, h: cloudEl.height, dir: '/dither/cloud' };
    const TREE = { w: treeEl.width, h: treeEl.height, dir: '/dither/tree' };

    const cctx = cloudEl.getContext('2d', { alpha: true });
    const tctx = enableTree ? treeEl.getContext('2d', { alpha: true }) : null;
    if (!cctx) return;
    if (enableTree && !tctx) return;
    cctx.imageSmoothingEnabled = false;
    if (tctx) tctx.imageSmoothingEnabled = false;

    const pad = (i: number) => String(i).padStart(2, '0');
    const frameUrl = (dir: string, i: number) => `${dir}/frame-${pad(i)}.webp`;

    const loadBitmap = async (url: string) => {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`dither load ${url}: ${res.status}`);
      return createImageBitmap(await res.blob());
    };

    type Cache = Map<number, ImageBitmap>;
    type Loading = Map<number, Promise<ImageBitmap | null>>;

    const makeRing = () => {
      const cache: Cache = new Map();
      const loading: Loading = new Map();

      const ensure = (dir: string, idx: number) => {
        const hit = cache.get(idx);
        if (hit) return Promise.resolve(hit);
        const pending = loading.get(idx);
        if (pending) return pending;
        const p = loadBitmap(frameUrl(dir, idx))
          .then((bm) => {
            loading.delete(idx);
            if (cancelled) {
              bm.close();
              return null;
            }
            cache.set(idx, bm);
            return bm;
          })
          .catch(() => {
            loading.delete(idx);
            return null;
          });
        loading.set(idx, p);
        return p;
      };

      const trim = (center: number) => {
        for (const [k, bm] of cache) {
          if (Math.abs(k - center) > RING) {
            bm.close();
            cache.delete(k);
          }
        }
      };

      const warm = (dir: string, center: number) => {
        const jobs: Promise<ImageBitmap | null>[] = [];
        for (let d = -RING; d <= RING; d++) {
          const idx = center + d;
          if (idx >= 0 && idx < N) jobs.push(ensure(dir, idx));
        }
        trim(center);
        return Promise.all(jobs);
      };

      const get = (idx: number) => cache.get(idx);
      const clear = () => {
        for (const bm of cache.values()) bm.close();
        cache.clear();
        loading.clear();
      };

      return { ensure, warm, get, clear };
    };

    const cloud = makeRing();
    const tree = enableTree ? makeRing() : null;
    let cancelled = false;
    let raf = 0;
    let i = 0;
    let dir = 1;
    let last = 0;
    const dt = 1000 / FPS;

    const paint = (cb: ImageBitmap, tb: ImageBitmap | null) => {
      // clear + draw in same task — no empty intermediate frame
      cctx.clearRect(0, 0, CLOUD.w, CLOUD.h);
      cctx.drawImage(cb, 0, 0);
      if (tctx && tb) {
        tctx.clearRect(0, 0, TREE.w, TREE.h);
        tctx.drawImage(tb, 0, 0);
      }
    };

    const paintIfReady = (idx: number) => {
      const cb = cloud.get(idx);
      if (!cb) return;
      if (!enableTree || !tree) {
        paint(cb, null);
        return;
      }
      const tb = tree.get(idx);
      if (tb) paint(cb, tb);
    };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      if (enableTree) {
        Promise.all([
          loadBitmap('/dither/cloud.webp'),
          loadBitmap('/dither/tree.webp'),
        ]).then(([c, t]) => paint(c, t));
      } else {
        loadBitmap('/dither/cloud.webp').then((c) => paint(c, null));
      }
      return;
    }

    const tick = (ts: number) => {
      if (cancelled) return;
      if (ts - last >= dt) {
        last = ts;
        i += dir;
        if (i >= N - 1) {
          i = N - 1;
          dir = -1;
        } else if (i <= 0) {
          i = 0;
          dir = 1;
        }
        paintIfReady(i);
        const jobs = [cloud.warm(CLOUD.dir, i)];
        if (tree) jobs.push(tree.warm(TREE.dir, i));
        void Promise.all(jobs).then(() => {
          if (!cancelled) paintIfReady(i);
        });
      }
      raf = requestAnimationFrame(tick);
    };

    const start = () => {
      if (!cancelled && !raf) raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    const onVis = () => (document.hidden ? stop() : start());
    document.addEventListener('visibilitychange', onVis);

    const boot = enableTree && tree
      ? Promise.all([cloud.ensure(CLOUD.dir, 0), tree.ensure(TREE.dir, 0)]).then(
          ([c0, t0]) => {
            if (c0 && t0) paint(c0, t0);
            return Promise.all([
              cloud.warm(CLOUD.dir, 0),
              tree.warm(TREE.dir, 0),
            ]);
          },
        )
      : cloud.ensure(CLOUD.dir, 0).then((c0) => {
          if (c0) paint(c0, null);
          return cloud.warm(CLOUD.dir, 0);
        });

    boot
      .then(() => {
        if (!document.hidden) start();
      })
      .catch(() => {
        if (enableTree) {
          Promise.all([
            loadBitmap('/dither/cloud.webp'),
            loadBitmap('/dither/tree.webp'),
          ]).then(([c, t]) => paint(c, t));
        } else {
          loadBitmap('/dither/cloud.webp').then((c) => paint(c, null));
        }
      });

    // Astro may re-run; no React cleanup — page unload is enough.
    // Keep refs so GC does not reclaim mid-play (rings hold bitmaps).
    (host as HTMLDivElement & { __dither?: unknown }).__dither = {
      cloud,
      tree,
      enableTree,
      stop: () => {
        cancelled = true;
        stop();
        document.removeEventListener('visibilitychange', onVis);
        cloud.clear();
        tree?.clear();
      },
    };
  })();
</script>
