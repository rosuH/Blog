{
  "name": "blog-astro",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal blog built with Astro",
  "author": "rosu",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run build && node --test --test-concurrency=1 tests/build-cache-config.test.mjs tests/performance-output.test.mjs tests/media-output.test.mjs && npm run test:ui",
    "test:ui": "node --test tests/ui-regressions.test.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "astro": "^5.0.0",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "fast-xml-parser": "5.5.10"
  }
}
